  <para style="li2">
    <verse number="15" style="v" sid="EZR 2:15"/>ta Adin 454<verse eid="EZR 2:15"/></para>
  <para style="li2">
    <verse number="16" style="v" sid="EZR 2:16"/>ta Ater (ta wurin Hezekiya) 98<verse eid="EZR 2:16"/></para>
